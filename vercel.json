{
  "installCommand": "npm install --omit=dev",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/art/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/art/sprites/boulder.png",
      "destination": "/art/boulder/sprite.png"
    },
    {
      "source": "/art/sprites/pyro.png",
      "destination": "/art/feuer/sprite.png"
    },
    {
      "source": "/art/sprites/pyra.png",
      "destination": "/art/feuer/sprite.png"
    },
    {
      "source": "/art/sprites/bastion.png",
      "destination": "/art/aegir/sprite.png"
    },
    {
      "source": "/art/sprites/aegir.png",
      "destination": "/art/aegir/sprite.png"
    },
    {
      "source": "/art/sprites/vex.png",
      "destination": "/art/vex/sprite.png"
    },
    {
      "source": "/art/sprites/glacia.png",
      "destination": "/art/frostbane/sprite.png"
    },
    {
      "source": "/art/sprites/frostbane.png",
      "destination": "/art/frostbane/sprite.png"
    },
    {
      "source": "/art/sprites/brakk.png",
      "destination": "/art/ironhorn/sprite.png"
    },
    {
      "source": "/art/sprites/ironhorn.png",
      "destination": "/art/ironhorn/sprite.png"
    },
    {
      "source": "/art/sprites/lumen.png",
      "destination": "/art/solace/sprite.png"
    },
    {
      "source": "/art/sprites/solace.png",
      "destination": "/art/solace/sprite.png"
    },
    {
      "source": "/art/sprites/kestrel.png",
      "destination": "/art/talon/sprite.png"
    },
    {
      "source": "/art/sprites/talon.png",
      "destination": "/art/talon/sprite.png"
    },
    {
      "source": "/art/sprites/morrow.png",
      "destination": "/art/graveborn/sprite.png"
    },
    {
      "source": "/art/sprites/graveborn.png",
      "destination": "/art/graveborn/sprite.png"
    },
    {
      "source": "/art/sprites/tempest.png",
